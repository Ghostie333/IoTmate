# Mongo root user (admin)
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=Lubieczolga#1

# App database
MONGO_DB=iotmate

# App user (used by backend connection string)
MONGO_APP_USER=iotmate_app
MONGO_APP_PASS=change_me_app

# Where the app user is created/authenticated
# If you create the app user inside the iotmate DB, keep this as iotmate.
# If you create it in admin, set to admin.
MONGO_AUTH_SOURCE=iotmate
