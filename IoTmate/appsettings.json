{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mqtt": {
    "Host": "mqtt",
    "Port": 1883,
    "TelemetryTopic": "devices/+/telemetry/#",
    "CommandTopicPrefix": "devices/"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://iotmate_app:change_me_app@mongo:27017/iotmate?authSource=iotmate",
    "Database": "iotmate"
  },
  "ConnectionStrings": {
    "Auth": "Data Source=/app/data/auth.db;"
  },
  "AllowedHosts": "*"
}
