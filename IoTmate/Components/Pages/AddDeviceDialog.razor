@rendermode @(new InteractiveServerRenderMode())

<MudDialog>
    <DialogContent>
        <MudTextField Label="DeviceId" @bind-Value="_deviceId" Required="true" Immediate="true" />
        <MudTextField Label="Name" @bind-Value="_name" Immediate="true" Class="mt-3" />
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_deviceId)" OnClick="AddAsync">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _deviceId = string.Empty;
    private string _name = string.Empty;
    private string? _error;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task AddAsync()
    {
        _error = null;
        var response = await Http.PostAsJsonAsync("api/device-provisioning/add", new { deviceId = _deviceId, name = _name });
        if (response.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        _error = await response.Content.ReadAsStringAsync();
    }
}
