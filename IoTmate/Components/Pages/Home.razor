@page "/"
@rendermode @(new InteractiveServerRenderMode())

<MudPaper Elevation="0" Class="pa-6" Style="background: transparent;">
    <MudText Typo="Typo.h3" GutterBottom="true">IoTmate</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6">
        Manage your devices and automation rules.
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Urządzenia</MudText>
                    <MudText Typo="Typo.h6">Devices</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Add devices, check online/offline status and last seen timestamp.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/devices">Go to devices</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Automatyzacje</MudText>
                    <MudText Typo="Typo.h6">Automations</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Planned: time-based and event-driven rules (MQTT).</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="true">Coming soon</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudPaper>
