@page "/"
@rendermode @(new InteractiveServerRenderMode())

<MudPaper Elevation="0" Class="pa-6" Style="background: transparent;">
    <MudText Typo="Typo.h3" GutterBottom="true">IoTmate</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6">
        Panel do zarządzania urządzeniami i regułami automatyzacji.
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Urządzenia</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Dodawaj urządzenia, sprawdzaj online/offline i ostatni kontakt.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/devices">Przejdź do urządzeń</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Automatyzacje</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Docelowo: reguły czasowe i event-driven (MQTT).</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="true">Wkrótce</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudPaper>
