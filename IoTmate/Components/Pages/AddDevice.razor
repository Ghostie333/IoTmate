@page "/devices/add"
@rendermode @(new InteractiveServerRenderMode())

<h1>Add device</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudCard>
            <MudCardContent>
                <form method="post" action="/api/device-provisioning/add-form">
                    <AntiforgeryTokenField />
                    <MudTextField Name="DeviceId" Label="DeviceId" @bind-Value="_deviceId" Required="true" Immediate="true" />
                    <MudTextField Name="Name" Label="Name" @bind-Value="_name" Immediate="true" Class="mt-3" />

                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Text" Href="/devices">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_deviceId)">Add</MudButton>
                    </MudStack>
                </form>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _deviceId = string.Empty;
    private string _name = string.Empty;

    private string? _error;

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    protected override void OnParametersSet()
    {
        _error = ErrorQuery;
    }
}
