@page "/register"
@rendermode @(new InteractiveServerRenderMode())

@using System.ComponentModel.DataAnnotations

<h1>Create account</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudCard>
            <MudCardContent>
                <form method="post" action="/register">
                    <MudTextField Name="Email" Label="Email" @bind-Value="_model.Email" For="() => _model.Email" Required="true" />
                    <MudTextField Name="Password" Label="Password" InputType="InputType.Password" @bind-Value="_model.Password" For="() => _model.Password" Required="true" Class="mt-3" />
                    <MudTextField Name="ConfirmPassword" Label="Confirm password" InputType="InputType.Password" @bind-Value="_model.ConfirmPassword" For="() => _model.ConfirmPassword" Required="true" Class="mt-3" />

                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                        Create account
                    </MudButton>
                </form>

                <MudText Class="mt-3">
                    Already have an account? <MudLink Href="/login">Sign in</MudLink>
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private readonly RegisterModel _model = new();
    private string? _error;

    private sealed class RegisterModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(6)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
