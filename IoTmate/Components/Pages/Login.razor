@page "/login"
@rendermode @(new InteractiveServerRenderMode())

@using System.ComponentModel.DataAnnotations

<h1>Sign in</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudCard>
            <MudCardContent>
                <form method="post" action="/login">
                    <MudTextField Name="Email" Label="Email" @bind-Value="_model.Email" For="() => _model.Email" Required="true" />
                    <MudTextField Name="Password" Label="Password" InputType="InputType.Password" @bind-Value="_model.Password" For="() => _model.Password" Required="true" Class="mt-3" />
                    <MudCheckBox Name="RememberMe" T="bool" @bind-Value="_model.RememberMe" Label="Remember me" Class="mt-3" />

                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                        Sign in
                    </MudButton>
                </form>

                <MudText Class="mt-3">
                    Don't have an account? <MudLink Href="/register">Create one</MudLink>
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private readonly LoginModel _model = new();
    private string? _error;

    private sealed class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
