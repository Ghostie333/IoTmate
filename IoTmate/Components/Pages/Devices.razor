@page "/devices"
@rendermode @(new InteractiveServerRenderMode())

<h1>Devices</h1>

<AuthorizeView>
    <Authorized>
        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/devices/add">
                Add device
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync">
                Refresh
            </MudButton>
        </MudStack>

        @if (_devices is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_devices" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Last seen (UTC)</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="d">
                    <MudTd DataLabel="Id">@d.Id</MudTd>
                    <MudTd DataLabel="Name">@d.Name</MudTd>
                    <MudTd DataLabel="Status">
                        <MudBadge Color="@(d.Online ? Color.Success : Color.Default)" Content="@(d.Online ? "Online" : "Offline")" />
                    </MudTd>
                    <MudTd DataLabel="Last seen (UTC)">@(d.LastSeenUtc?.ToString("u") ?? "-")</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Href="@($"/devices/{d.Id}/telemetry")">Telemetry</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            You must sign in to see your devices. <MudLink Href="/login">Go to login</MudLink>
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<IoTmate.Contracts.Devices.DeviceDto>? _devices;

    [Inject] private IoTmate.Services.IDeviceStore DeviceStore { get; set; } = default!;
    [Inject] private IoTmate.Services.ITelemetryBus Telemetry { get; set; } = default!;
    [Inject] private IoTmate.Authentication.ICurrentUser CurrentUser { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            var userId = CurrentUser.UserId;
            if (string.IsNullOrWhiteSpace(userId))
            {
                _devices = Array.Empty<IoTmate.Contracts.Devices.DeviceDto>();
                return;
            }

            var list = DeviceStore.GetAll(userId);
            _devices = list
                .Select(d =>
                {
                    var last = Telemetry.GetLatest(d.Id, 1).FirstOrDefault();
                    return last is null ? d : d with { Online = true, LastSeenUtc = last.TimestampUtc };
                })
                .ToArray();
        }
        catch
        {
            _devices = Array.Empty<IoTmate.Contracts.Devices.DeviceDto>();
        }
        StateHasChanged();
    }

}
